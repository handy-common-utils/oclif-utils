{
  "name": "simple-cli-prj",
  "version": "3.0.1",
  "description": "oclif example Hello World CLI",
  "author": "James Hu @james-hu",
  "bin": {
    "simple-cli-prj": "./bin/run"
  },
  "homepage": "https://github.com/james-hu/simple-cli-prj",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "james-hu/simple-cli-prj",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "oclif": "^6",
    "shx": "^0.3.4",
    "tsx": "^4",
    "tslib": "^2.8.1",
    "typescript": "^6"
  },
  "oclif": {
    "bin": "simple-cli-prj",
    "dirname": "simple-cli-prj"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": "https://github.com/james-hu/simple-cli-prj/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts"
}
