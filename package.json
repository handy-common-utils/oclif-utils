{
  "name": "@handy-common-utils/oclif-utils",
  "version": "3.0.0",
  "description": "oclif related utilities",
  "scripts": {
    "format:all": "prettier --write --ignore-unknown .",
    "pretest": "eslint .",
    "test": "c8 mocha",
    "compile": "shx rm -rf dist && tsc",
    "prepare": "husky && npm run compile && es-check",
    "preversion": "generate-api-docs-and-update-readme && git add README.md"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {},
  "dependencies": {
    "@handy-common-utils/fs-utils": ">=1.1.1",
    "@handy-common-utils/promise-utils": ">=1.5.0"
  },
  "peerDependencies": {
    "@oclif/core": ">=2 <7"
  },
  "devDependencies": {
    "@handy-common-utils/dev-dependencies-mocha": "^1.11.13",
    "@oclif/test": "^5.0.1",
    "oclif": "^6.0.2",
    "zx": "^8.8.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/handy-common-utils/oclif-utils#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/handy-common-utils/oclif-utils.git"
  },
  "bugs": {
    "url": "https://github.com/handy-common-utils/oclif-utils/issues"
  },
  "keywords": [
    "oclif",
    "utils",
    "utilities"
  ],
  "author": "James Hu",
  "license": "Apache-2.0",
  "overrides": {
    "eslint-plugin-unicorn": "64.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "volta": {
    "node": "22.22.3",
    "npm": "10.8.2"
  }
}
