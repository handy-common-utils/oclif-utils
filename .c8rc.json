{
  "all": true,
  "include": ["src/**"],
  "exclude": [
    "**/dist/**",
    "**/*.d.ts",
    "**/node_modules/**",
    "test/**",
    "**/test/**",
    "**/coverage/lcov-report/*.js"
  ],
  "clean": true,
  "temp-directory": "coverage",
  "report-dir": "coverage",
  "skip-full": true,
  "reporter": ["json", "html", "text"],
  "check-coverage": false
}
